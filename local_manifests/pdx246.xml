<!-- SPDX-FileCopyrightText: Johannes Meyer zum Alten Borgloh
     SPDX-License-Identifier: BSD-3-Clause

     Device repos of the Xperia 10 VI (pdx246) from the LineageOS 23.2 port, pinned by SHA so
     that repo sync never moves them; bump the pins on purpose.
     The device tree and the kernel come from the port's forks, pinned to their hybris-23.2
     branches (the LineageOS release commits plus the Sailfish OS commits); the kernel modules,
     the kernel device trees (the LineageOS port's own repos) and hardware/sony (the device
     tree's lineage.dependencies, listed here so roomservice never fetches it) are the LineageOS
     release's commits.
     The three kernel paths must keep these names: the kernel tree has a symlink to
     ../sm6450-devicetrees and the modules tree hard-codes sm6450-modules. -->
<manifest>
  <remote name="pdx246" fetch="https://github.com/sailfishos-sony-pdx246" />
  <remote name="johanneszab" fetch="https://github.com/johanneszab" />
  <project path="device/sony/pdx246" name="android_device_sony_pdx246" remote="pdx246"
           revision="948da1759c9fc462cd205af6f35c41004e141029" upstream="hybris-23.2" />
  <project path="kernel/sony/sm6450" name="android_kernel_sony_sm6450" remote="pdx246"
           revision="c4bf2dd135832b8444b811a6ab72368efcc5d494" upstream="hybris-23.2" />
  <project path="kernel/sony/sm6450-modules" name="android_kernel_sony_sm6450-modules" remote="johanneszab"
           revision="5f823f90b852edf3d8c848a270173113ff523fe9" upstream="lineage-23.2" />
  <project path="kernel/sony/sm6450-devicetrees" name="android_kernel_sony_sm6450-devicetrees" remote="johanneszab"
           revision="958dce5aaab6c58df7573843e85398b477d8dc62" upstream="lineage-23.2" />
  <project path="hardware/sony" name="LineageOS/android_hardware_sony" remote="github"
           revision="cedda154f4fbd2d1668e2a816dac7350e824645f" upstream="lineage-23.2" />
</manifest>
